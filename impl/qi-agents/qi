#!/usr/bin/env python3
"""
qi —— 契网命令行（agent 无关，任何能执行 shell 的 agent 都能用）

  qi whoami
  qi send --to 192.168.1.192:9733 --file msg.json [--type qi/knowledge/share]
  qi send --to HOST:PORT --text "你好" [--name 标题]
  qi inbox [--limit 10] [--full]
  qi read <文件名或 message_id 前缀>
  qi serve --port 9733
  qi peer add <名字> <host:port>     # 只记在 ~/.qi/peers.json，供 qi send 用名字

设计原则：输出尽量是 JSON 或一行摘要，便于 agent 解析。
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

import qi_net


def _peer_book() -> dict:
    p = qi_net.data_dir() / "peers.json"
    return json.loads(p.read_text()) if p.exists() else {}


def _resolve(to: str) -> str:
    peers = _peer_book()
    return peers.get(to, to)


def cmd_whoami(a):
    ident = qi_net.load_identity(a.data_dir)
    card = qi_net.load_card(a.data_dir)
    print(json.dumps({
        "did": ident.node_id,
        "address": qi_net.my_address(card),
        "name": (card.get("identity") or {}).get("name", ""),
        "inbox": len(qi_net.inbox(1000, a.data_dir)),
        "peers_known": list(_peer_book()),
    }, ensure_ascii=False, indent=2))


def cmd_send(a):
    ident = qi_net.load_identity(a.data_dir)
    if a.file:
        payload = json.loads(Path(a.file).read_text())
    elif a.text:
        payload = {"kind": "note", "name": a.name or "note", "content": a.text}
    else:
        sys.exit("需要 --file 或 --text")
    r = qi_net.send(_resolve(a.to), a.type, payload, ident,
                    to_node=a.to_node or "", timeout=a.timeout)
    print(json.dumps(r, ensure_ascii=False, indent=2))
    sys.exit(0 if r.get("ok") else 1)


def cmd_inbox(a):
    recs = qi_net.inbox(a.limit, a.data_dir)
    if a.json:
        print(json.dumps(recs, ensure_ascii=False, indent=2))
        return
    if not recs:
        print("收件箱为空")
        return
    for r in recs:
        e = r["envelope"]
        print(f"{r['received_at'][:19]}  {e['type']:<24} verified={r['verified']}  "
              f"{r['_file']}  from={e['signer'][:20]}…")
        if e.get("payload", {}).get("name"):
            print(f"    └ {e['payload']['name']}: {str(e['payload'].get('summary') or e['payload'].get('content') or '')[:80]}")


def cmd_read(a):
    for r in qi_net.inbox(1000, a.data_dir):
        mid = r["envelope"].get("message_id", "")
        if a.selector in r["_file"] or mid.endswith(a.selector) or mid == a.selector:
            print(json.dumps(r, ensure_ascii=False, indent=2))
            return
    sys.exit(f"未找到: {a.selector}")


def cmd_serve(a):
    qi_net.serve(a.port, a.host, a.data_dir)


def cmd_unread(a):
    """列出还没处理过的消息（来自事件流，不是 inbox 目录）。

    与 `inbox` 的区别：inbox 是「收到过什么」，unread 是「还没处理的」。
    两者用不同的记录：inbox 落盘的每封信都在，unread 靠
    ~/.qi-node/events.jsonl 与 ~/.qi-node/handled.jsonl 的差集算出来。
    """
    try:
        import qi_notify
    except Exception:                                        # noqa: BLE001
        sys.exit("qi_notify 未就位（应在本目录下）")

    if a.count:
        print(qi_notify.unread_count(a.data_dir))
        return

    items = qi_notify.unread(a.data_dir)
    if a.json:
        print(json.dumps(items, ensure_ascii=False, indent=2))
        return
    if not items:
        print("没有未读消息")
        return
    print(f"未读 {len(items)} 条：")
    for r in items:
        print(f"  {r.get('type') or '?'}  ←  {r.get('from_short') or '?'}")
        if r.get("body_preview"):
            print(f"    {r['body_preview'][:100]}")
        print(f"    at={r.get('at', '?')}  id={r.get('message_id')}")


def cmd_ack(a):
    """标记某条消息已处理。处理完该回的消息就该调这个，否则它会一直算未读。"""
    try:
        import qi_notify
    except Exception:                                        # noqa: BLE001
        sys.exit("qi_notify 未就位（应在本目录下）")
    qi_notify.mark_handled(a.message_id, note=a.note or "", by=a.by or "", data_dir=a.data_dir)
    if not str(a.message_id).startswith("urn:"):                 # 2026-11-20 修：events 存全 urn，裸 uuid 需补记否则 unread 永不清零
        qi_notify.mark_handled(f"urn:qi:msg:{a.message_id}", note=a.note or "", by=a.by or "", data_dir=a.data_dir)
    print(f"已标记 {a.message_id}")



def cmd_policy(a):
    path = qi_net.data_dir(a.data_dir) / qi_net.POLICY_FILENAME
    if a.action == "show":
        print(json.dumps(qi_net.load_policy(a.data_dir), ensure_ascii=False, indent=2))
        return
    try:
        cur = json.loads(path.read_text())
    except FileNotFoundError:
        cur = {}
    if a.action == "set":
        if a.did:
            tgt = cur.setdefault("per_did", {}).setdefault(a.did, {})
        else:
            tgt = cur.setdefault("defaults", {})
        for flag, key in ((a.max_mb, "max_file_mb"), (a.quota_gb, "quota_gb"),
                          (a.daily_gb, "daily_gb"), (a.msg_max_kb, "msg_max_kb")):
            if flag is not None:
                tgt[key] = flag
        if a.deny:
            tgt["deny"] = True
        if getattr(a, "no_deny", False):
            tgt.pop("deny", None)
        if a.disclose is not None:
            cur["disclose"] = a.disclose
        cur = {k: v for k, v in cur.items()
               if not (isinstance(v, (dict, list)) and not v)}
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(cur, ensure_ascii=False, indent=2))
        tmp.replace(path)
        print(f"已写入 {path}（{'DID ' + a.did if a.did else '默认档'}）")
    elif a.action == "rm":
        cur.get("per_did", {}).pop(a.did, None)
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(cur, ensure_ascii=False, indent=2))
        tmp.replace(path)
        print(f"已移除 {a.did} 的条目")


def cmd_peer(a):
    p = qi_net.data_dir() / "peers.json"
    book = _peer_book()
    if a.action == "add":
        book[a.name] = a.address
        p.write_text(json.dumps(book, ensure_ascii=False, indent=2))
        print(f"已登记 {a.name} → {a.address}")
    elif a.action == "rm":
        book.pop(a.name, None)
        p.write_text(json.dumps(book, ensure_ascii=False, indent=2))
        print(f"已移除 {a.name}")
    elif a.action == "list":
        print(json.dumps(book, ensure_ascii=False, indent=2) if book else "（空）")


def main(argv=None):
    ap = argparse.ArgumentParser(prog="qi", description="契网命令行（agent 无关）")
    ap.add_argument("--data-dir", default=None)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("whoami").set_defaults(fn=cmd_whoami)

    s = sub.add_parser("send")
    s.add_argument("--to", required=True, help="host:port 或 qi peer 名")
    s.add_argument("--type", default=qi_net.DEFAULT_TYPE)
    s.add_argument("--file", help="payload JSON 文件")
    s.add_argument("--text", help="直接发一段文本")
    s.add_argument("--name", default="", help="--text 时的标题")
    s.add_argument("--to-node", default="", help="收件人 DID（可留空）")
    s.add_argument("--timeout", type=float, default=5.0)
    s.set_defaults(fn=cmd_send)

    i = sub.add_parser("inbox")
    i.add_argument("--limit", type=int, default=10)
    i.add_argument("--json", action="store_true")
    i.add_argument("--full", action="store_true")
    i.set_defaults(fn=cmd_inbox)

    r = sub.add_parser("read")
    r.add_argument("selector")
    r.set_defaults(fn=cmd_read)

    v = sub.add_parser("serve")
    v.add_argument("--port", type=int, default=9733)
    # 默认必须是 :: —— 0.0.0.0 只监听 IPv4，对端走 IPv6 会连不上（见 qi_net.serve 的
    # _DualStackServer 分支：host 里没有冒号就不走双栈）。这是踩过两次的坑。
    v.add_argument("--host", default="::")
    v.set_defaults(fn=cmd_serve)

    u = sub.add_parser("unread", help="列出还没处理过的消息（事件流差集）")
    u.add_argument("--count", action="store_true", help="只输出数量")
    u.add_argument("--json", action="store_true")
    u.set_defaults(fn=cmd_unread)

    k = sub.add_parser("ack", help="标记某条消息已处理")
    k.add_argument("message_id")
    k.add_argument("--note", default="")
    k.add_argument("--by", default="")
    k.set_defaults(fn=cmd_ack)


    q = sub.add_parser("policy")
    q.add_argument("action", choices=["show", "set", "rm"])
    q.add_argument("--did", default="", help="目标DID（留空=默认档）")
    q.add_argument("--max-mb", type=float, default=None, dest="max_mb")
    q.add_argument("--quota-gb", type=float, default=None, dest="quota_gb")
    q.add_argument("--daily-gb", type=float, default=None, dest="daily_gb")
    q.add_argument("--msg-max-kb", type=int, default=None, dest="msg_max_kb")
    q.add_argument("--deny", action="store_true", help="对该DID拒收")
    q.add_argument("--no-deny", action="store_true", dest="no_deny", help="解除拒收")
    q.add_argument("--disclose", action="store_true", default=None, help="应答策略探询")
    q.add_argument("--no-disclose", action="store_false", dest="disclose")
    q.set_defaults(fn=cmd_policy)

    p = sub.add_parser("peer")
    p.add_argument("action", choices=["add", "rm", "list"])
    p.add_argument("name", nargs="?", default="")
    p.add_argument("address", nargs="?", default="")
    p.set_defaults(fn=cmd_peer)

    a = ap.parse_args(argv)
    a.fn(a)


if __name__ == "__main__":
    main()
